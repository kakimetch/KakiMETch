  {
   "id": "notes",
   "type": "text",
   "x": 200,
   "y": 715,
   "width": 756.8000000000001,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 649821630,
   "version": 1,
   "versionNonce": 996247159,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022 Services never import each other; shared code lives only in kakimetch_common.\n\u2022 All four services share one database. The frontend never talks to Supabase directly.\n\u2022 Matching and scheduling use the same escort hard filters (escort_rules),\n   so suggestions and the final confirm check cannot disagree.",
   "originalText": "\u2022 Services never import each other; shared code lives only in kakimetch_common.\n\u2022 All four services share one database. The frontend never talks to Supabase directly.\n\u2022 Matching and scheduling use the same escort hard filters (escort_rules),\n   so suggestions and the final confirm check cannot disagree.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
